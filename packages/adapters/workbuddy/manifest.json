{
  "manifestVersion": 1,
  "id": "workbuddy",
  "name": "WorkBuddy",
  "version": "0.0.0",
  "adapterApiVersion": 1,
  "launchCommand": true,
  "entry": "./dist/plugin.js",
  "icon": "./assets/icon.svg",
  "installation": {
    "commands": [],
    "before": {
      "en": "Download and install the WorkBuddy desktop app.",
      "zh-CN": "请下载并安装 WorkBuddy 桌面应用。"
    },
    "downloads": [
      { "label": "WorkBuddy (中国区)", "url": "https://www.workbuddy.cn/" },
      { "label": "WorkBuddy (Global)", "url": "https://www.workbuddy.ai/" }
    ],
    "after": {
      "en": "The bundled CLI may require separate login. Restart codexhost after changing the installation path.",
      "zh-CN": "内置 CLI 可能需要单独登录。修改安装路径后需重启 codexhost。"
    }
  },
  "links": {
    "website": "https://www.workbuddy.cn/",
    "installation": "https://www.workbuddy.cn/docs/workbuddy/Quickstart",
    "documentation": "https://www.workbuddy.cn/docs/workbuddy/Overview"
  }
}
